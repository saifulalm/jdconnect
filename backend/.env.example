# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_DATABASE=pulsa

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Node Env
NODE_ENV=production

# CORS
# Comma-separated origins
FRONTEND_URL=http://localhost:4001,http://localhost:3000

# TypeORM
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# Heroku Postgres (auto-filled)
DATABASE_URL=

# API Keys (for production)
XENDIT_SECRET_KEY=
SUPABASE_ANON_KEY=
