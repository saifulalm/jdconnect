# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_DATABASE=pulsa

# JWT — WAJIB. Aplikasi menolak start bila kosong (tidak ada fallback).
# Minimal 32 karakter di produksi. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Di belakang load balancer / Cloudflare / Nginx, isi jumlah proxy (mis. 1)
# agar IP asli klien terbaca. Tanpa ini, IP whitelist H2H dan rate limit
# per-IP melihat alamat proxy untuk semua orang.
TRUST_PROXY=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis switch (recommended on Heroku unless add-on Redis is enabled)
ENABLE_REDIS=false

# Redis TLS (Heroku Redis often uses rediss:// with self-signed cert)
REDIS_TLS=false
REDIS_REJECT_UNAUTHORIZED=false

# Node Env
NODE_ENV=production

# CORS
# Comma-separated origins
FRONTEND_URL=http://localhost:4001,http://localhost:3000

# ==========================================================================
# Rekonsiliasi otomatis (cron tiap menit)
#   - Order sudah dibayar tapi top-up nyangkut -> tanya status ke supplier
#   - Order menunggu bayar -> cek status ke gateway (webhook bisa hilang)
#   - Order tak dibayar >24 jam -> ditandai kedaluwarsa
# Set "false" hanya jika Anda menjalankan worker terpisah untuk tugas ini.
# ==========================================================================
RECONCILIATION_ENABLED=true

# TypeORM
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# Heroku Postgres (auto-filled)
DATABASE_URL=

# ==========================================================================
# PAYMENT GATEWAY — Midtrans (Snap)
# Leave MIDTRANS_SERVER_KEY empty to run the built-in MOCK gateway (dev/demo).
# Get keys: https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
# ==========================================================================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --------------------------------------------------------------------------
# Open-source QRIS fallback (no PJP): paste your merchant STATIC QRIS payload
# (scan your printed QRIS with a QR reader to get the raw string). Orders get
# a DYNAMIC QRIS with the amount embedded; settlement is confirmed manually
# by an admin via POST /api/payment/confirm/{invoice}. Used only when
# MIDTRANS_SERVER_KEY is empty.
# --------------------------------------------------------------------------
QRIS_STATIC_CODE=
# Midtrans webhook URL to register in dashboard:
#   {BACKEND_URL}/api/payment/midtrans/callback

# ==========================================================================
# SUPPLIER (H2H) — pulsa/PPOB upstream
# SUPPLIER_DRIVER: auto | digiflazz | mock
#   auto  -> use first configured real supplier, else mock
#   mock  -> always mock (no real top-up, free testing)
# ==========================================================================
SUPPLIER_DRIVER=auto
SUPPLIER_MARKUP_PERCENT=5

# Digiflazz — https://developer.digiflazz.com
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_PROD_KEY=
DIGIFLAZZ_DEV_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=
# Digiflazz callback URL to register:
#   {BACKEND_URL}/api/supplier/callback

# ==========================================================================
# OTP + notifikasi (loginless & verifikasi). Driver dipilih otomatis:
#   WHATSAPP_TOKEN terisi -> WhatsApp  (disarankan di Indonesia)
#   TWILIO_* terisi       -> SMS
#   keduanya kosong       -> log saja, kode OTP di-echo untuk dev
# WHATSAPP_API_URL default kompatibel Fonnte (POST target+message,
# header Authorization: <token>). Gateway lain dengan kontrak sama juga bisa.
# ==========================================================================
WHATSAPP_TOKEN=
WHATSAPP_API_URL=https://api.fonnte.com/send

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ==========================================================================
# Email (SMTP) — transaction receipts
# ==========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Legacy / optional
XENDIT_SECRET_KEY=
SUPABASE_ANON_KEY=
